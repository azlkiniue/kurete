---
import Base from '../layouts/Base.astro';
import TimelineChart from '../components/TimelineChart.astro';
import ReleaseTable from '../components/ReleaseTable.astro';
import UpcomingReleases from '../components/UpcomingReleases.astro';
import EolReleases from '../components/EolReleases.astro';
import { snapshot, upcoming, nextEol, nextPatch } from '../data/releases';
import { formatDate, countdownParts, formatCountdown, sinceText } from '../lib/dates';

const nowMs = Date.now();
const cd0 = (iso: string) => formatCountdown(countdownParts(iso, nowMs));
const builtDate = snapshot.generatedAt.slice(0, 10);
---

<Base>
  <main class="wrap">
    <header class="hero">
      <div class="hero-top">
        <div class="brand">
          <svg class="logo" viewBox="0 0 64 64" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="#326ce5"></rect>
            <g fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="32" cy="32" r="6.5" fill="#fff" stroke="none"></circle>
              <circle cx="32" cy="32" r="17"></circle>
              <line x1="32" y1="15" x2="32" y2="25.5"></line>
              <line x1="46.7" y1="23.5" x2="37.6" y2="28.8"></line>
              <line x1="46.7" y1="40.5" x2="37.6" y2="35.2"></line>
              <line x1="32" y1="49" x2="32" y2="38.5"></line>
              <line x1="17.3" y1="40.5" x2="26.4" y2="35.2"></line>
              <line x1="17.3" y1="23.5" x2="26.4" y2="28.8"></line>
            </g>
          </svg>
          <div class="wordmark">
            <h1 title="暮れて (kurete): as dusk falls and a day draws to its close, every release has its sunset.">
              Kurete
            </h1>
            <span class="tagline">Kubernetes Release Timeline</span>
          </div>
        </div>
        <button
          type="button"
          class="theme-btn"
          data-theme-toggle
          aria-label="Theme: system (follows your OS)"
          title="Theme: system (follows your OS)"
        >
          <svg class="ti ti-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          <svg class="ti ti-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="ti ti-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>
      </div>
      <p class="lede">
        Support windows, end-of-life dates, and the next release of Kubernetes.
      </p>

      <div class="kpis">
        {
          upcoming && (
            <div class="kpi card">
              <span class="kpi-label">Next release · {upcoming.version}</span>
              <span class="cd kpi-cd" data-countdown={upcoming.releaseDate} data-countdown-past="Released 🎉">
                {cd0(upcoming.releaseDate)}
              </span>
              <span class="kpi-sub">{formatDate(upcoming.releaseDate)}</span>
            </div>
          )
        }
        {
          nextEol && (
            <div class="kpi card">
              <span class="kpi-label">Next end-of-life · {nextEol.version}</span>
              <span class="cd kpi-cd" data-countdown={nextEol.eolDate} data-countdown-past="reached">
                {cd0(nextEol.eolDate)}
              </span>
              <span class="kpi-sub">{formatDate(nextEol.eolDate)}</span>
            </div>
          )
        }
        {
          nextPatch && (
            <div class="kpi card">
              <span class="kpi-label">Next patch day</span>
              <span class="cd kpi-cd" data-countdown={nextPatch.targetDate} data-countdown-past="due">
                {cd0(nextPatch.targetDate)}
              </span>
              <span class="kpi-sub">{formatDate(nextPatch.targetDate)}</span>
            </div>
          )
        }
      </div>
    </header>

    <section class="section" aria-labelledby="t-timeline">
      <div class="section-head">
        <div>
          <h2 id="t-timeline">Release timeline</h2>
          <p>Active support and maintenance windows for recent, current, and upcoming releases.</p>
        </div>
      </div>
      <TimelineChart />
    </section>

    <section class="section" aria-labelledby="t-supported">
      <div class="section-head">
        <div>
          <h2 id="t-supported">Supported releases</h2>
          <p>Currently maintained releases plus the most recent to roll off. Colors flag deadlines within 90 days.</p>
        </div>
      </div>
      <ReleaseTable />
    </section>

    <section class="section" aria-labelledby="t-upcoming">
      <div class="section-head">
        <div>
          <h2 id="t-upcoming">Upcoming</h2>
          <p>The next minor version and its release-cycle milestones, plus upcoming patch days.</p>
        </div>
      </div>
      <UpcomingReleases />
    </section>

    <section class="section" aria-labelledby="t-eol">
      <div class="section-head">
        <div>
          <h2 id="t-eol">End-of-life releases</h2>
          <p>
            Historical archive of every release that has reached end of life.
          </p>
        </div>
      </div>
      <EolReleases />
    </section>

    <footer class="foot">
      <p>
        Data from the official Kubernetes release schedule —{' '}
        <a href="https://kubernetes.io/releases/" target="_blank" rel="noopener">kubernetes.io/releases</a>{' '}
        (<a href={snapshot.sources.schedule} target="_blank" rel="noopener">schedule.yaml</a>,{' '}
        <a href={snapshot.sources.eol} target="_blank" rel="noopener">eol.yaml</a>,{' '}
        <a href="https://github.com/kubernetes/sig-release" target="_blank" rel="noopener">sig-release</a>).
        <br>
        Historical release dates for end-of-life versions courtesy of{' '}
        <a href={snapshot.sources.kubeApi} target="_blank" rel="noopener">kube-api.ninja</a>{' '}
        by xrstf
        (<a href="https://codeberg.org/xrstf/kube-api.ninja" target="_blank" rel="noopener">source</a>).
      </p>
      <p class="foot-meta">
        Snapshot built {formatDate(builtDate)}{' '}
        (<span data-since={builtDate}>{sinceText(builtDate)}</span>){!snapshot.fresh && <span class="stale"> · served from cache</span>}.
        Not affiliated with the Kubernetes project.
      </p>
    </footer>
  </main>

  <script>
    import '../lib/countdown.client.ts';
  </script>
</Base>

<style>
  .hero {
    padding-top: 0.5rem;
  }
  .hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .logo {
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: 10px;
  }
  .wordmark {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(1.5rem, 4.5vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    cursor: help;
    width: fit-content;
  }
  .tagline {
    font-size: clamp(0.72rem, 2vw, 0.82rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .lede {
    margin: 0.9rem 0 0;
    max-width: 60ch;
    color: var(--text-muted);
    font-size: 1rem;
  }

  .theme-btn {
    appearance: none;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .theme-btn:hover {
    background: var(--surface-2);
    border-color: var(--accent);
    color: var(--accent);
  }
  .theme-btn .ti {
    width: 19px;
    height: 19px;
    display: none;
  }
  /* Show the icon matching the active mode (set on <html> before paint). */
  :global([data-theme-mode='system']) .theme-btn .ti-system,
  :global([data-theme-mode='light']) .theme-btn .ti-light,
  :global([data-theme-mode='dark']) .theme-btn .ti-dark {
    display: block;
  }

  .kpis {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 720px) {
    .kpis {
      grid-template-columns: 1fr;
    }
  }
  .kpi {
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .kpi-label {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--text-muted);
  }
  .kpi-cd {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    font-size: clamp(1.25rem, 3.6vw, 1.6rem);
    color: var(--accent);
  }
  .kpi-cd.is-past {
    color: var(--ok-fg);
  }
  .kpi-sub {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .foot {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }
  .foot p {
    margin: 0 0 0.5rem;
  }
  .stale {
    color: var(--soon-fg);
  }
</style>
